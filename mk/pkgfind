#! /usr/bin/env perl

=head1 pkgfind

This tool finds l4re packages in the provided source dir by looking for a
`Control` file. Packages and projects (directories with a Makefile including
`mk/project.mk`, e.g. multi-package repositories) marked 'obsolete' or 'broken'
by a respective file are skipped including all packages below them, unless
they are the source dir itself.

Args:


=over

=item 1: source dir to locate packages in

=item 2: max search depth

=back

=cut

use strict;
use File::Spec::Functions;

my ($p, $max) = @ARGV;

my %hits;

sub is_prj_dir
{
  my $d = shift;
  open(my $fh, '<', "$d/Makefile") or return 0;
  while (<$fh>) {
    return 1 if /^\s*include\s+\$\(L4DIR\)\/mk\/project\.mk/;
  }
  return 0;
}

sub find_dir
{
  my $m = shift;
  my $dx = catdir(@_);
  my $d = catdir($p, @_);
  my $pkg = -f "$d/Control";
  # The source dir itself is never skipped to allow building packages and
  # projects marked broken or obsolete directly in their directory.
  if (@_ and ($pkg or is_prj_dir($d))
      and (-f "$d/obsolete" or -f "$d/broken")) {
    return;
  }
  if ($pkg) {
    $hits{$dx} = 1;
    return;
  }
  return if $m <= 1;

  opendir (my $dh, $d) || "can't open $d: $!";
  foreach my $sd (readdir($dh)) {
    next if $sd eq '.' or $sd eq '..';
    next if $sd eq '.git' or $sd eq '.svn';
    my $fd = catdir($d, $sd);
    next unless -d $fd;
    find_dir($m - 1, @_, $sd);
  }
  closedir $dh;
}

find_dir($max);

print join("\n", sort(keys(%hits))). "\n";
